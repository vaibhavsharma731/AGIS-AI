# AegisAI Environment Configuration Example
# Copy this file to .env and fill in your credentials

# LLM Provider: "groq", "nvidia", or "google"
LLM_PROVIDER=groq

# AI API Keys
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Model Selection
GROQ_MODEL_NAME=openai/gpt-oss-120b
NVIDIA_MODEL_NAME=deepseek-ai/deepseek-v4.1-flash
GOOGLE_MODEL_NAME=gemini-1.5-flash-latest

# RAG & Knowledge Base
FAISS_INDEX_PATH=backend/knowledge/faiss_index

# Server Settings
HOST=0.0.0.0
PORT=8000

# GitHub Integration (Optional - can also be configured dynamically in the Web UI)
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=your_username/your_repo

# AWS CloudWatch Integration (Optional - can also be configured dynamically in the Web UI)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=/aws/apps/orders-api
CLOUDWATCH_LOG_STREAM=

# Execution Target Configuration
DOCKER_CONTAINER_NAME=payment-backend-worker
